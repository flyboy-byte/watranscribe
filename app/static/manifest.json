{
  "name": "WAtranscribe",
  "short_name": "WAtranscribe",
  "description": "Transcribe and summarize WhatsApp audio messages",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#075E54",
  "theme_color": "#075E54",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/static/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "audio/opus",
            "audio/mp4",
            "audio/mpeg",
            "audio/wav",
            "audio/ogg"
          ]
        }
      ]
    }
  }
}
