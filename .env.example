# Copy to .env and fill in. Never commit the real .env file.

# Required in production (Flask session signing, CSRF). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Deepgram transcription API key.
DEEPGRAM_API_KEY=

# Anthropic Claude API key (summarization). Legacy names also supported:
# AI_INTEGRATIONS_ANTHROPIC_API_KEY / AI_INTEGRATIONS_ANTHROPIC_BASE_URL
ANTHROPIC_API_KEY=

# If set, enables the password gate (sha256 cookie token + attempt lockout).
# This must be a werkzeug salted hash, NOT the raw password. Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
# Leave unset to disable the gate entirely (not recommended in production).
APP_PASSWORD_HASH=

# Set to "1" in production so Flask fails fast if SECRET_KEY/APP_PASSWORD_HASH
# are missing/insecure and cookies are forced Secure. Leave unset for local dev.
FLASK_ENV=development
