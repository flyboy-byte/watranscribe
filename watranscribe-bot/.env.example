# Copy to .env and fill in real values. Never commit .env.

# Meta / WhatsApp Business Cloud API
# --- The token you choose and enter into Meta's webhook config UI (any
#     random string you pick) — used only for the GET verification handshake.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# --- Meta App Secret (App Dashboard -> App Settings -> Basic). Used to
#     validate the X-Hub-Signature-256 header on every webhook POST.
WHATSAPP_APP_SECRET=
# --- Temporary (or permanent, once set up) access token for the Cloud API,
#     from the WhatsApp > API Setup page in the Meta App Dashboard.
WHATSAPP_ACCESS_TOKEN=
# --- Phone number ID (not the phone number itself) from the same page.
WHATSAPP_PHONE_NUMBER_ID=

# Deepgram
DEEPGRAM_API_KEY=

# Flask
FLASK_ENV=development
